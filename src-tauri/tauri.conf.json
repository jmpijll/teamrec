{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TeamRec",
  "version": "1.0.0",
  "identifier": "com.teamrec.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "TeamRec",
        "width": 680,
        "height": 400,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Beautiful Microsoft Teams audio recorder",
    "longDescription": "TeamRec is a minimal, cross-platform desktop app that records Microsoft Teams audio output with one click."
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/jmpijll/teamrec/releases/latest/download/latest.json"
      ]
    }
  }
}
